# --- Database ---
# Leave unset to use an embedded PGlite database in ./.pglite (zero setup, local dev only).
# For production (or a real Postgres locally), set a connection string:
# DATABASE_URL=postgres://user:pass@host:5432/immersemoar

# Max Postgres connections opened per process (only applies when DATABASE_URL is set).
# Each PM2/worker process opens its own pool, so keep this low and let Neon's pooler
# (the "-pooler" host in your DATABASE_URL) handle fan-out across workers. Default: 5.
# DB_POOL_MAX=5

# --- Auth (Better Auth) ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Site ---
# Canonical public origin, no trailing slash. Used for sitemap.xml/robots.txt entries,
# the web manifest, and Open Graph image URLs (src/lib/site.ts) — anywhere an absolute
# URL is needed outside of a request context. Falls back to BETTER_AUTH_URL if unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) ---
# Used for password reset and email verification links.
# Leave RESEND_API_KEY unset in local dev — emails are logged to the console instead of sent.
# Free key from https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. resend.dev sender works for testing without a custom domain.
EMAIL_FROM="immersemoar <onboarding@resend.dev>"

# --- Cron ---
# Shared secret for the weekly-recap trigger endpoint (src/app/api/cron/weekly-recap).
# The endpoint is public (no session) but refuses every request without this secret as
# either ?secret=... or an `Authorization: Bearer ...` header. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NOTE: nothing calls this on a schedule yet — wiring up an actual cron (VPS crontab,
# external scheduler, etc.) is a deployment-time step, not done here.
CRON_SECRET=

# --- Admin / moderation ---
# Comma-separated emails always treated as admin (see src/lib/admin.ts), for
# bootstrapping the first admin before anyone has role="admin" in the database.
# Once you have a real admin account, promote others from /admin instead.
ADMIN_EMAILS=

# --- External metadata sources ---
# TMDB (movies & series): free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Google Books works without a key (rate-limited). Optional:
GOOGLE_BOOKS_API_KEY=
# AniList and VNDB need no keys.
